# Example environment variables for Open Deep Research
# Copy this file to .env and fill in your API keys

# LLM Provider API Keys
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key  # For Google Gemini models
GROQ_API_KEY=your-groq-api-key
TOGETHER_API_KEY=your-together-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
FIREWORKS_API_KEY=your-fireworks-api-key
NVIDIA_API_KEY=your-nvidia-api-key
MISTRAL_API_KEY=your-mistral-api-key
AI21_API_KEY=your-ai21-api-key
COHERE_API_KEY=your-cohere-api-key

# Search API Keys
TAVILY_API_KEY=your-tavily-api-key
EXA_API_KEY=your-exa-api-key
PERPLEXITYAI_API_KEY=your-perplexity-api-key

# Google Search (if using googlesearch provider)
GOOGLE_API_KEY=your-google-api-key  # Same as above if using Google for both
GOOGLE_CX=your-google-custom-search-engine-id

# PubMed (optional)
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=your-pubmed-api-key

# Azure AI Search (optional)
AZURE_SEARCH_KEY=your-azure-search-key
AZURE_SEARCH_ENDPOINT=https://your-service.search.windows.net
AZURE_SEARCH_INDEX=your-index-name

# AWS Bedrock (optional)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_SESSION_TOKEN=your-aws-session-token  # If using temporary credentials

# Configuration overrides (optional)
# USE_WBG_MODELS=true  # Set to true to use WBG endpoints
# SEARCH_API=tavily  # Override default search API
# PLANNER_MODEL=openai:gpt-4o  # Override planner model
# WRITER_MODEL=openai:gpt-4o  # Override writer model
# SUPERVISOR_MODEL=openai:gpt-4o  # Override supervisor model (multi-agent)
# RESEARCHER_MODEL=openai:gpt-4o  # Override researcher model (multi-agent)